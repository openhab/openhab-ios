//
//  Signing.local.xcconfig
//
//  Lets you build and run openHAB on your own iPhone and Apple Watch without being a
//  member of the openHAB development team.
//
//  1. Copy this file to Signing.local.xcconfig (it is git-ignored).
//  2. Set your team ID: Xcode > Settings > Accounts > your team, or
//     developer.apple.com > Membership details.
//  3. Choose a bundle ID prefix you own, e.g. com.yourname. Bundle IDs become
//     com.yourname.app, com.yourname.app.NotificationService, … and the app group
//     group.com.yourname.app. Xcode registers them automatically on first build.
//  4. Build the Debug configuration to your device.
//
//  Don't pick a team in Xcode's Signing & Capabilities pane: it would be written into
//  project.pbxproj and override this file. The pane showing the team in red as
//  "Unknown Name (TEAMID)" and unexpanded bundle IDs is expected; signing works.
//
//  Not available in these builds: CarPlay (the entitlement is granted to the openHAB
//  team only), and Crashlytics and myopenHAB push notifications, which are tied to
//  the official bundle ID. A free Personal Team additionally lacks push, Siri and
//  App Groups; use a paid Apple Developer account for a fully working build.

DEVELOPMENT_TEAM = ABCDE12345
OPENHAB_BUNDLE_ID_PREFIX = com.yourname

// Same entitlements as the official app, minus CarPlay.
OPENHAB_APP_ENTITLEMENTS = openHAB/Supporting Files/openHAB.entitlements
